# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Real business discovery (Scout Agent) ----
# GOOGLE_PLACES_API_KEY: Google Cloud API key with "Places API" enabled.
# Without this, Scout Agent falls back to AI-generated demo companies (clearly
# labeled is_demo=true) instead of real businesses.
GOOGLE_PLACES_API_KEY=""

# ---- Real outbound email (Sales Agent delivery) ----
# RESEND_API_KEY + RESEND_FROM_EMAIL: https://resend.com — create an API key
# and verify a sending domain/address. Without these, messages are drafted
# but never actually delivered (send will fail with a clear error).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ---- Autonomous operation (no human in the loop) ----
# AUTO_DISCOVERY_INDUSTRIES: comma-separated industries to search on a schedule.
# e.g. "Healthcare,Hospitality,Retail" — leave empty to disable scheduled discovery.
AUTO_DISCOVERY_INDUSTRIES=""
# AUTO_DISCOVERY_REGION: default "Yerevan"
AUTO_DISCOVERY_REGION="Yerevan"
# AUTO_DISCOVERY_INTERVAL_MIN: how often (minutes) Scout Agent runs. Default 60.
AUTO_DISCOVERY_INTERVAL_MIN="60"
# AUTONOMOUS_MODE: "true" to auto-approve and send outreach WITHOUT human review.
# Leave unset/"false" to keep every outbound message gated on manual approval
# in the app UI (recommended until you trust the drafts).
AUTONOMOUS_MODE="false"
# AUTONOMOUS_SEND_INTERVAL_MIN: how often (minutes) the scheduler flushes
# pending outreach when AUTONOMOUS_MODE=true. Default 15.
AUTONOMOUS_SEND_INTERVAL_MIN="15"
